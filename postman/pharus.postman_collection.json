	"item": [
		{
			"name": "Health & Diagnostics",
			"item": [
				{
					"name": "Get Health Status",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Response contains service name and status ok', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.service).to.eql('pharus-daemon');",
									"    pm.expect(jsonData.status).to.eql('ok');",
									"    pm.expect(jsonData.uptime).to.exist;",
									"    pm.expect(jsonData.time).to.exist;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get System Status",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Response status is running and vector_db is chromem-go', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql('running');",
									"    pm.expect(jsonData.vector_db).to.eql('chromem-go');",
									"    pm.expect(jsonData.minimax_model).to.exist;",
									"    pm.expect(jsonData.embed_provider).to.exist;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"status"
							]
						}
					},
					"response": []
				}
			]
		},
