# ==============================================================================
# Pharus - Plantilla de Variables de Entorno (.env.example)
# Copia este archivo a .env y configura tus credenciales
# ==============================================================================

# LLM Provider Selección: "minimax", "openai", "anthropic", "ollama"
PHARUS_LLM_PROVIDER="minimax"

# 1. MiniMax LLM Provider (Responses API - OpenAPI 3.1.0)
PHARUS_MINIMAX_API_KEY="tu_api_key_aqui"
PHARUS_MINIMAX_GROUP_ID="tu_group_id_opcional"
PHARUS_MINIMAX_MODEL="MiniMax-M3"
PHARUS_MINIMAX_BASE_URL="https://api.minimax.io/v1"

# 2. OpenAI LLM Provider
PHARUS_OPENAI_API_KEY=""
PHARUS_OPENAI_MODEL="gpt-4o-mini"
PHARUS_OPENAI_BASE_URL="https://api.openai.com/v1"

# 3. Anthropic LLM Provider
PHARUS_ANTHROPIC_API_KEY=""
PHARUS_ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
PHARUS_ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"

# 4. Ollama Local LLM Provider
PHARUS_OLLAMA_LLM_URL="http://localhost:11434"
PHARUS_OLLAMA_LLM_MODEL="llama3.1"

# SearXNG Engine URL
PHARUS_SEARXNG_URL="http://localhost:8090"

# Embeddings Server (Ollama)
PHARUS_EMBEDDING_URL="http://localhost:11434"

# llama.cpp Local Inference Server (GBNF)
PHARUS_LLAMACPP_URL="http://localhost:8080"
PHARUS_LLAMACPP_MODEL="qwen2.5-coder-7b-instruct"

# Perfil de investigación predeterminado: quick, balanced o deep
PHARUS_RESEARCH_PROFILE="balanced"
